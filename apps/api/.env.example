NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/brewora
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
CUSTOMER_URL=http://localhost:3000
# Admin portal is part of the web app (/admin), so no separate ADMIN_URL is needed.

# Initial admin (used by `npm run seed`; no default password exists)
ADMIN_EMAIL=admin@brewora.pk
ADMIN_PASSWORD=
ADMIN_NAME=BREWORA Admin
# Optional: password for seeded demo customers (random if empty)
SEED_DEMO_PASSWORD=

# SMTP (emails are only logged if SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BREWORA <no-reply@brewora.pk>"

# Cloudinary (signed direct uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JazzCash (online payment stays Pending until verified callback)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# EasyPaisa (see docs/PAYMENTS.md before going live)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_BASE_URL=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf

# Local image uploads (served at /uploads). Default: ./uploads
UPLOAD_DIR=
