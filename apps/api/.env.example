# ---- Copy these into Vercel > Project > Settings > Environment Variables (do NOT upload a real .env file) ----
NODE_ENV=production
API_URL=https://YOUR-API.vercel.app
CUSTOMER_URL=https://YOUR-WEB.vercel.app
# MongoDB Atlas connection string (localhost does NOT work on Vercel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/brewora?retryWrites=true&w=majority
JWT_ACCESS_SECRET=generate-a-long-random-string-min-32
JWT_REFRESH_SECRET=generate-another-long-random-string-min-32

# Admin account (used only by `npm run seed`, run on your own computer)
ADMIN_EMAIL=admin@brewora.pk
ADMIN_PASSWORD=
ADMIN_NAME=BREWORA Admin
SEED_DEMO_PASSWORD=

# Cloudinary — REQUIRED on Vercel for admin image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (emails are only logged if SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BREWORA <no-reply@brewora.pk>"

# JazzCash / EasyPaisa (optional)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_BASE_URL=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf
